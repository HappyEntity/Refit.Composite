<Project>
    <Import Project="$([MsBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <RefitTestVersion Condition="'$(RefitTestVersion)' == ''">16.*</RefitTestVersion>
        <IsPackable>false</IsPackable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>obj/generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Refit.Composite.SourceGenerator\Refit.Composite.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>

        <!-- CI also runs the tests against the lowest supported Refit: -p:RefitTestVersion=15.0.0 -->
        <PackageReference Include="Refit.HttpClientFactory" VersionOverride="$(RefitTestVersion)" />
    </ItemGroup>
</Project>
